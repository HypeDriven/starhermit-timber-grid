{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    // skipLibCheck: the 1.13.1 starhermit.d.ts names AntialiasMode in starhermit:engine without importing it (fixed in engine 1.13.2)
    "skipLibCheck": true
  },
  "files": [".starhermit/starhermit.d.ts", "native/main.ts"]
}
